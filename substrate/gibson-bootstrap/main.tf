# ----------------------------------------------------------------------------
# Stage 0 for one AWS environment (ADR-0083, docs/bringup.md § The stages).
#
# In plain words: the things that outlive every cluster of an
# environment. This workspace creates them once, and no teardown mode
# reaches them.
#
#   durable bucket   bucket.tf        zeroroot-ai-<env>-durable-<account>
#   platform user    credentials.tf   the bucket credential in the keyring, no s3:Delete*
#   SMTP relay       credentials.tf   SES SMTP user by default, or an operator's relay
#   DNS sub-zone     zone.tf          <env>.zeroroot.ai, delegated from the apex
#   disk registry    ecr.tf           zeroroot-ai-<env>-setec-disks, the signed setec disks (D85)
#
# The fourth input of the contract, the bringup keyring, is generated by
# scripts/keyring.sh, not by Terraform: substrate.sh runs this workspace,
# then writes the keyring from three Terraform outputs plus two generated
# randoms, then writes substrate.env. See substrate.sh.
#
# No KMS key. The old bootstrap encrypted the state bucket with a KMS key it
# created. ADR-0083 puts no cloud KMS in the data path, so the durable bucket
# uses SSE-S3 (AES256), and this workspace creates no key of any kind.
# ----------------------------------------------------------------------------

data "aws_caller_identity" "current" {}

locals {
  account_id = data.aws_caller_identity.current.account_id

  bucket_name = "zeroroot-ai-${var.environment}-durable-${var.aws_account_id}"

  is_subzone = var.zone_name != var.apex_zone_name

  ses_relay = var.smtp_user == ""
  smtp_host = var.smtp_host != "" ? var.smtp_host : "email-smtp.${var.aws_region}.amazonaws.com"

  common_tags = {
    Environment = var.environment
    Project     = "zeroroot-ai"
    Owner       = "platform"
    CostCenter  = var.cost_center
    ManagedBy   = "terraform"
    Workspace   = "zeroroot-ai-${var.environment}-substrate"
  }
}
