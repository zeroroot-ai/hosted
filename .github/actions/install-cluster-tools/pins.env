# The one list of cluster tool pins (install.sh). Each value is a version and
# the sha256 of the exact file that install.sh downloads.
#
# helm: the sha256 is the release's own .sha256sum file at get.helm.sh.
HELM_VERSION=v3.22.0
HELM_SHA256=1e4ab49e429626cf6c6958d914248b78c9730803c2751b87627e171dc800e7bb
# kubectl: the sha256 is the release's own kubectl.sha256 file at dl.k8s.io.
# The minor version follows k3s_version of bootstrap/ec2/gibson (v1.35).
KUBECTL_VERSION=v1.35.9
KUBECTL_SHA256=3cfeaf80be482b435b0aa214aff6e0b2c312ee23c0ff20810c75517b6004c6eb
# session-manager-plugin: AWS publishes no checksum file for the deb. The
# sha256 is of the versioned file, which AWS does not change after release,
# read on 2026-10-12.
SSM_PLUGIN_VERSION=1.2.896.0
SSM_PLUGIN_SHA256=53f51fcc67314a4bf85888a38a3967cd41f8d0f28a60a9469a63acf935ba713e
