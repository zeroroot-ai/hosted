# ---------------------------------------------------------------------------
# The ECR credential provider of the kubelet (D85, hosted#521).
#
# Each setec launcher Pod mounts the signed disk of its image as an image
# volume, so the kubelet pulls the disk from the ECR repository that stage 0
# made. The kubelet gets the pull credential from the instance role through
# this plugin, so no pull secret exists (ecr.tf grants the role the pull).
#
# k3s reads the plugin configuration and the plugin directory at fixed paths,
# /var/lib/rancher/credentialprovider/config.yaml and
# /var/lib/rancher/credentialprovider/bin, so this runs before k3s starts.
#
# The binary is verified against its pinned SHA-256 before it is made
# executable. The kubelet runs it as root with the instance credentials.
# ---------------------------------------------------------------------------
ECR_CP_VERSION="${ecr_credential_provider_version}"
ECR_CP_SHA256="${ecr_credential_provider_sha256}"
ECR_CP_DIR=/var/lib/rancher/credentialprovider
install -d -m 0755 "$ECR_CP_DIR/bin"
if echo "$ECR_CP_SHA256  $ECR_CP_DIR/bin/ecr-credential-provider" | sha256sum -c --status 2>/dev/null; then
  echo "${log_prefix}: ecr-credential-provider $ECR_CP_VERSION is already installed"
else
  ecr_tmp="$(mktemp)"
  curl -fsSL --retry 10 --retry-delay 5 --retry-all-errors --connect-timeout 20 \
    "https://artifacts.k8s.io/binaries/cloud-provider-aws/$ECR_CP_VERSION/linux/amd64/ecr-credential-provider-linux-amd64" -o "$ecr_tmp"
  echo "$ECR_CP_SHA256  $ecr_tmp" | sha256sum -c --status \
    || { echo "${log_prefix}: FATAL ecr-credential-provider $ECR_CP_VERSION does not match its pinned SHA-256" >&2; rm -f "$ecr_tmp"; exit 1; }
  install -m 0755 "$ecr_tmp" "$ECR_CP_DIR/bin/ecr-credential-provider"
  rm -f "$ecr_tmp"
  echo "${log_prefix}: installed ecr-credential-provider $ECR_CP_VERSION"
fi
cat > "$ECR_CP_DIR/config.yaml" <<'CREDENTIALPROVIDER'
apiVersion: kubelet.config.k8s.io/v1
kind: CredentialProviderConfig
providers:
  - name: ecr-credential-provider
    matchImages:
      - "*.dkr.ecr.*.amazonaws.com"
    defaultCacheDuration: "12h"
    apiVersion: credentialprovider.kubelet.k8s.io/v1
CREDENTIALPROVIDER
